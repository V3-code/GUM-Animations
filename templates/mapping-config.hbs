<form class="gum-animation-config" autocomplete="off">
  <header class="gum-animation-config__hero">
    <div>
      <h2><i class="fas fa-wand-magic-sparkles"></i> {{localize "GUMAnimations.Mapping.Title"}}</h2>
      <p>{{localize "GUMAnimations.Mapping.Intro"}}</p>
    </div>
    <button type="button" data-action="add"><i class="fas fa-plus"></i> {{localize "GUMAnimations.Mapping.Add"}}</button>
  </header>

  <datalist id="gum-animation-paths">
    {{#each assetPaths}}<option value="{{this}}"></option>{{/each}}
  </datalist>

  <section class="gum-animation-config__rules">
    {{#each mappings as |mapping index|}}
      <article class="gum-animation-rule" data-mapping-id="{{mapping.id}}">
        <input type="hidden" name="mappings.{{index}}.id" value="{{mapping.id}}">
        <div class="gum-animation-rule__heading">
          <label class="gum-animation-rule__enabled">
            <input type="checkbox" name="mappings.{{index}}.enabled" {{checked mapping.enabled}}>
            <span>{{localize "GUMAnimations.Mapping.Enabled"}}</span>
          </label>
          <input class="gum-animation-rule__name" type="text" name="mappings.{{index}}.name" value="{{mapping.name}}" placeholder="{{localize 'GUMAnimations.Mapping.Name'}}">
          <div class="gum-animation-rule__actions">
            <button type="button" data-action="move-up" title="{{localize 'GUMAnimations.Mapping.MoveUp'}}"><i class="fas fa-arrow-up"></i></button>
            <button type="button" data-action="move-down" title="{{localize 'GUMAnimations.Mapping.MoveDown'}}"><i class="fas fa-arrow-down"></i></button>
            <button type="button" data-action="preview" title="{{localize 'GUMAnimations.Mapping.Preview'}}"><i class="fas fa-play"></i></button>
            <button type="button" data-action="delete" title="{{localize 'GUMAnimations.Mapping.Delete'}}"><i class="fas fa-trash"></i></button>
          </div>
        </div>

        <div class="gum-animation-rule__grid">
          <label>{{localize "GUMAnimations.Mapping.Event"}}
            <select name="mappings.{{index}}.eventType">
              {{selectOptions ../eventTypes selected=mapping.eventType valueAttr="value" labelAttr="label"}}
            </select>
          </label>
          <label>{{localize "GUMAnimations.Mapping.Result"}}
            <select name="mappings.{{index}}.result">
              {{selectOptions ../results selected=mapping.result valueAttr="value" labelAttr="label"}}
            </select>
          </label>
          <label>{{localize "GUMAnimations.Mapping.Placement"}}
            <select name="mappings.{{index}}.placement">
              {{selectOptions ../placements selected=mapping.placement valueAttr="value" labelAttr="label"}}
            </select>
          </label>
          <label>{{localize "GUMAnimations.Mapping.Scale"}}
            <input type="number" name="mappings.{{index}}.scale" value="{{mapping.scale}}" min="0.05" step="0.05">
          </label>

          <label class="gum-animation-rule__path">{{localize "GUMAnimations.Mapping.Path"}}
            <input type="text" name="mappings.{{index}}.path" value="{{mapping.path}}" list="gum-animation-paths" placeholder="jb2a.fire_bolt.orange">
          </label>
          <label class="gum-animation-rule__persist">
            <input type="checkbox" name="mappings.{{index}}.persist" {{checked mapping.persist}}>
            <span>{{localize "GUMAnimations.Mapping.Persist"}}</span>
          </label>
        </div>

        <details>
          <summary>{{localize "GUMAnimations.Mapping.Filters"}}</summary>
          <p class="notes">{{localize "GUMAnimations.Mapping.FiltersHint"}}</p>
          <div class="gum-animation-rule__grid gum-animation-rule__filters">
            <label class="gum-animation-item-drop">{{localize "GUMAnimations.Mapping.ItemUuid"}}
              <input type="text" name="mappings.{{index}}.itemUuid" value="{{mapping.itemUuid}}" placeholder="{{localize 'GUMAnimations.Mapping.DropItem'}}">
            </label>
            <label>{{localize "GUMAnimations.Mapping.ItemType"}}
              <input type="text" name="mappings.{{index}}.itemType" value="{{mapping.itemType}}">
            </label>
            <label>{{localize "GUMAnimations.Mapping.ActionType"}}
              <input type="text" name="mappings.{{index}}.actionType" value="{{mapping.actionType}}">
            </label>
            <label>{{localize "GUMAnimations.Mapping.ActionId"}}
              <input type="text" name="mappings.{{index}}.actionId" value="{{mapping.actionId}}">
            </label>
            <label>{{localize "GUMAnimations.Mapping.AttackType"}}
              <input type="text" name="mappings.{{index}}.attackType" value="{{mapping.attackType}}" placeholder="melee / ranged">
            </label>
          </div>
        </details>
      </article>
    {{else}}
      <div class="gum-animation-config__empty">
        <i class="fas fa-wand-magic-sparkles"></i>
        <p>{{localize "GUMAnimations.Mapping.Empty"}}</p>
      </div>
    {{/each}}
  </section>

  <footer class="sheet-footer flexrow">
    <button type="submit"><i class="fas fa-floppy-disk"></i> {{localize "GUMAnimations.Mapping.Save"}}</button>
  </footer>
</form>
